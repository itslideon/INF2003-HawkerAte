# copy to frontend/.env — never commit the real .env
# Vite only exposes variables prefixed with VITE_ to the browser, so this
# must stay VITE_API_BASE_URL, not the API_BASE_URL name in the root
# .env.example (that one's for backend/ETL scripts, not this app).

VITE_API_BASE_URL=http://localhost:3000
